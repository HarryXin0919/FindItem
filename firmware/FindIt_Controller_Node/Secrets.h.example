// Copy this file to `Secrets.h` in the same directory and fill it in locally.
//
//     copy Secrets.h.example Secrets.h
//
// `Secrets.h` is git-ignored (see the repository .gitignore). Never commit real
// Wi-Fi or MQTT credentials - AGENTS.md "Secrets" and the MQTT contract
// section 4 both forbid it.
//
// If `Secrets.h` is absent the firmware still compiles, using the placeholders
// in Config.h, and reports itself as unprovisioned rather than pretending.
#pragma once

#define FINDIT_WIFI_SSID "your-ssid"
#define FINDIT_WIFI_PASSWORD "your-wifi-password"

#define FINDIT_MQTT_HOST "192.168.1.10"
#define FINDIT_MQTT_PORT 1883
#define FINDIT_MQTT_USERNAME ""
#define FINDIT_MQTT_PASSWORD ""
